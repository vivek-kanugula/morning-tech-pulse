# Groq Cloud API Key (Get free from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gmail SMTP Settings
# SENDER_EMAIL: Your Gmail address sending the brief
SENDER_EMAIL=your_email@gmail.com

# RECEIVER_EMAIL: Where you want to receive the brief (can be same as sender)
RECEIVER_EMAIL=your_email@gmail.com

# GMAIL_APP_PASSWORD: 16-character Google App Password (Generated from https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
